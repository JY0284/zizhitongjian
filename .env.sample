# 复制为 .env 后填写本地配置（不要提交 .env）

# `knowledge_extraction.py` 使用的 DeepSeek API Key
DEEPSEEK_API_KEY=

# 默认抽取模型；推理负载较重时使用 deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash

# 高德地图 Web 服务 Key，用于地点地理编码
AMAP_KEY=

# 独立预算抽取脚本使用的 OpenAI 兼容服务配置
LLM_API_KEY=
LLM_BASE_URL=

# 私有价格核验配置与可选对账接口（不提交实际配置）
LLM_PRICING_CONFIG=
LLM_BILLING_LOG_URL=
LLM_BILLING_UNITS_PER_CNY=
